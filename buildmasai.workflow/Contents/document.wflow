					<key>COMMAND_STRING</key>
					<string># get the correct python environment
source /Users/christian/Library/Enthought/Canopy_64bit/User/bin/activate

# go to masai directory
cd /Users/christian/Dropbox/PycharmProjects/masai

# make test
cd tests
python -m unittest discover 
cd ..
pwd

# commit and push
git add .
git commit -a -m "$@"
git push origin master


;set l12=l11 for symmetric incrementation of number of R cycles
;$OWNER=scadars
"l12=l11"

;calculate length of one rotor period
"d31 = 1.0s/cnst31"

;calculate length of excitation and reconversion periods
"d11 = 2*l11*d31*l2"
"d12 = 2*l12*d31*l2"
# 85 "/home/nmr/prog/pp/cpSR26_sync.sc"
;calculate the 90 and 270 pulse lengths for R element
"p11 = 0.25*d31*l2/l1"
"p12 = 0.75*d31*l2/l1"


"acqt0=1u*cnst11"
# 92 "/home/nmr/prog/pp/cpSR26_sync.sc"
;calculate the R element phase (phi=nu/N*pi)
;"cnst1 = (180.0*l3)/l1 + cnst0"

